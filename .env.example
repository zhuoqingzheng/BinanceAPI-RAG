# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=

# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# "openai" for real embeddings, or "fake" to test the pipeline offline
# (no API calls, no cost, but search results are meaningless).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# Model that writes the answers for `rag ask`.
ANSWER_MODEL=gpt-5-mini
